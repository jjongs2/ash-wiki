+    if (!script.includes(from)) throw new Error(`ash-wiki search 패치: 클라이언트 스크립트에 ${from}이 없다`);
+    return script.replace(from, to);
+  }, search_inline_default);
   Search.css = search_default;
   return Search;
 });
