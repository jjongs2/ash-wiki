diff --git a/node_modules/@quartz-community/explorer/dist/index.js b/node_modules/@quartz-community/explorer/dist/index.js
--- a/node_modules/@quartz-community/explorer/dist/index.js
+++ b/node_modules/@quartz-community/explorer/dist/index.js
@@ -517,7 +517,19 @@ var Explorer_default = ((userOpts) => {
     );
   };
   ExplorerComponent.css = explorer_default;
-  ExplorerComponent.afterDOMLoaded = concatenateResources(explorer_inline_default, overflowListAfterDOMLoaded);
+  // ash-wiki: 업스트림 스크립트는 서랍을 열고 닫을 때 aria-expanded를 role 없는 div.explorer에 건다(axe
+  // aria-allowed-attr, #638). 열고 닫는 때는 누른 토글 버튼에, 폰에서 처음 접을 때는 메뉴 버튼(.mobile-explorer)에 건다.
+  const explorerToggleExpanded = 'C.setAttribute("aria-expanded",c?"false":"true")';
+  const explorerLoadExpanded = 't.setAttribute("aria-expanded","false")';
+  for (const part of [explorerToggleExpanded, explorerLoadExpanded]) {
+    if (explorer_inline_default.split(part).length !== 2) throw new Error(`ash-wiki explorer 패치: 클라이언트 스크립트에 ${part}가 한 번 있어야 한다`);
+  }
+  ExplorerComponent.afterDOMLoaded = concatenateResources(
+    explorer_inline_default
+      .replace(explorerToggleExpanded, 'this.setAttribute("aria-expanded",c?"false":"true")')
+      .replace(explorerLoadExpanded, 'n.setAttribute("aria-expanded","false")'),
+    overflowListAfterDOMLoaded
+  );
   return ExplorerComponent;
 });
 
