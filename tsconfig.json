{
  "compilerOptions": {
    "lib": ["esnext", "DOM", "DOM.Iterable"],
    "experimentalDecorators": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "incremental": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    // ash-wiki: 로컬 플러그인(plugins/)은 빌드가 그대로 불러오도록 JS로 쓰고, 파일 맨 위 // @ts-check로 검사한다
    "allowJs": true
  },
  // ash-wiki: tools/(콘텐츠 검사기, bib 합치기)와 plugins/(로컬 플러그인)도 타입 검사한다
  "include": [
    "quartz/**/*.ts",
    "quartz/**/*.tsx",
    "tools/**/*.ts",
    "plugins/**/*.ts",
    "plugins/**/*.js",
    "*.ts",
    "*.tsx",
    "./package.json"
  ],
  "exclude": [
    "build/**/*.d.ts",
    ".quartz/**/src/**",
    ".quartz/**/test/**",
    "node_modules/**",
    "quartz/cli/tui/**"
  ]
}
